{
  "manifest_version": 3,
  "name": "MultiCV",
  "version": "1.0.0",
  "description": "Multicv is an extension that able you to create personalized cv for diferent jobs offers",
  "permissions": ["activeTab"],
  "externally_connectable": {
    "matches": ["https://multicv.space/*"]
  },
  "host_permissions": [
    "https://multicv.space/*",
    "https://www.linkedin.com/*",
    "https://www.infojobs.net/*"
  ],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://multicv.space/*",
        "https://www.linkedin.com/*",
        "https://www.infojobs.net/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
