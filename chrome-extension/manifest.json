{
    "manifest_version": 3,
    "name": "MultiCV",
    "version": "1.0.0",
    "description": "Multicv is an extension that able you to create personalized cv for diferent jobs offers",
    "permissions": ["activeTab"],
    "host_permissions": ["https://www.linkedin.com/*"],
    "icons": {
        "16": "icons/icon.png",
        "48": "icons/icon.png",
        "128": "icons/icon.png"
    },
    "content_scripts": [
        {
            "matches": ["https://www.linkedin.com/*"],
            "js": ["content.js"],
            "css": ["styles.css"]
        }
    ]
}
