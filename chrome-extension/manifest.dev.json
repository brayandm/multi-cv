{
  "manifest_version": 3,
  "name": "MultiCV",
  "version": "1.0.0",
  "description": "Multicv is an extension that able you to create personalized cv for diferent jobs offers",
  "permissions": ["cookies", "activeTab", "storage"],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://dev.multicv.space/*",
      "https://multicv.space/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:3000/*",
    "https://dev.multicv.space/*",
    "https://multicv.space/*",
    "https://www.linkedin.com/*",
    "https://www.infojobs.net/*"
  ],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://dev.multicv.space/*",
        "https://multicv.space/*",
        "https://www.linkedin.com/*",
        "https://www.infojobs.net/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
