FROM python:3.13

ENV LANG=C.UTF-8

WORKDIR /app

RUN pip install --no-cache-dir pipenv

RUN apt-get update

RUN apt-get install -y \
        texlive-latex-base \
        texlive-latex-extra \
        texlive-latex-recommended \
        texlive-fonts-recommended

RUN apt-get install -y texlive-lang-all

RUN apt-get install -y texlive-xetex