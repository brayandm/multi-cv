#!/bin/bash

set -e

# Get staged files
STAGED_FILES=$(git diff --name-only --cached --diff-filter=d)

if [ -z "$STAGED_FILES" ]; then
    echo "No files to lint"
    exit 0
fi

# Create arrays to store files
BACKEND_FILES=()
FRONTEND_FILES=()
CHROME_EXTENSION_FILES=()
ENGINE_FILES=()

# Classify files by directory and extension
for file in $STAGED_FILES; do
    if [[ $file == backend/*.php ]]; then
        BACKEND_FILES+=("${file#backend/}")
    elif [[ $file == frontend/* && ($file == *.js || $file == *.ts || $file == *.tsx) ]]; then
        FRONTEND_FILES+=("${file#frontend/}")
    elif [[ $file == chrome-extension/* && ($file == *.js || $file == *.ts || $file == *.tsx) ]]; then
        CHROME_EXTENSION_FILES+=("${file#chrome-extension/}")
    elif [[ $file == engine/*.py ]]; then
        ENGINE_FILES+=("${file#engine/}")
    fi
done

# Run linters
if [ ${#BACKEND_FILES[@]} -gt 0 ]; then
    docker run --rm \
        -u "$(id -u):$(id -g)" \
        -v $(pwd)/backend:/var/www/html \
        -w /var/www/html \
        brayand/fullstack-project-template-php-git:1.0.0 \
        vendor/bin/pint "${BACKEND_FILES[@]}"
fi

if [ ${#FRONTEND_FILES[@]} -gt 0 ]; then
    docker run --rm \
        -u "$(id -u):$(id -g)" \
        -v $(pwd)/frontend:/app \
        -w /app \
        brayand/fullstack-project-template-frontend:1.0.0 \
        sh -c "npx prettier --write ${FRONTEND_FILES[*]} && npx eslint --fix ${FRONTEND_FILES[*]}"
fi

if [ ${#CHROME_EXTENSION_FILES[@]} -gt 0 ]; then
    docker run --rm \
        -u "$(id -u):$(id -g)" \
        -v $(pwd)/chrome-extension:/app \
        -w /app \
        brayand/fullstack-project-template-frontend:1.0.0 \
        sh -c "npx prettier --write ${CHROME_EXTENSION_FILES[*]}"
fi

if [ ${#ENGINE_FILES[@]} -gt 0 ]; then
    docker run --rm \
        -u "$(id -u):$(id -g)" \
        -v $(pwd)/engine:/app \
        -w /app \
        -e WORKON_HOME=/app/.venvs/hook \
        -e PIPENV_VENV_IN_PROJECT=0 \
        brayand/fullstack-project-template-python-pipenv:1.0.0 \
        sh -c "pipenv install --dev && pipenv run black ${ENGINE_FILES[*]} && pipenv run isort ${ENGINE_FILES[*]}"
fi