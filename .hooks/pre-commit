#!/bin/sh

set -e

cd backend
docker run --rm \
    -u "$(id -u):$(id -g)" \
    -v $(pwd):/var/www/html \
    -w /var/www/html \
    brayand/fullstack-project-template-backend:1.0.0 \
    vendor/bin/pint
cd ..

cd frontend
docker run --rm \
    -u "$(id -u):$(id -g)" \
    -v $(pwd):/app \
    -w /app \
    brayand/fullstack-project-template-frontend:1.0.0 \
    sh -c "npx prettier --write . && npm run lint"
cd ..

cd chrome-extension
docker run --rm \
    -u "$(id -u):$(id -g)" \
    -v $(pwd):/app \
    -w /app \
    brayand/fullstack-project-template-frontend:1.0.0 \
    sh -c "npx prettier --write ."
cd ..

cd engine
docker run --rm \
    -u "$(id -u):$(id -g)" \
    -v $(pwd):/app \
    -w /app \
    -e WORKON_HOME=/app/.venvs/hook \
    brayand/fullstack-project-template-python:1.0.0 \
    sh -c "pipenv install --dev && pipenv run black . && pipenv run isort ."
cd ..

