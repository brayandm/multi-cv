FROM brayand/fullstack-project-template-php:1.0.0

COPY . /var/www

WORKDIR /var/www

RUN composer install

COPY docker/php8/docker-start.sh /docker-start.sh

COPY docker/php8/php.ini /usr/local/etc/php/conf.d/local.ini

RUN chmod +x /docker-start.sh

RUN mkdir -p /etc/supervisor/conf.d/

COPY docker/php8/laravel-worker.conf /etc/supervisor/conf.d/laravel-worker.conf

COPY docker/php8/www.conf /etc/php/8.1/fpm/pool.d/www.conf

WORKDIR /var/www

EXPOSE 9000
